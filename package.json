{
  "name": "vue-calendarium",
  "version": "2.0.0",
  "description": "A polished, full-featured scheduling and calendar component for Vue 3 and Vuetify, with Temporal API date handling, recurring events (RRULE), i18n and mobile gestures",
  "type": "module",
  "main": "./lib/vue-calendarium.js",
  "module": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "node": "./lib/vue-calendarium.js",
      "default": "./lib/index.js"
    },
    "./style.css": "./lib/vue-calendarium.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue",
    "test": "vitest run tests/unit",
    "test:package": "npm run build:lib && node scripts/check-node-import.mjs",
    "media": "node scripts/capture-media.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:ui:report": "playwright show-report"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuetify",
    "calendar",
    "scheduler",
    "events",
    "rrule",
    "temporal",
    "i18n"
  ],
  "author": "zehenrique <10810709+zehenrique@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://zehenrique.github.io/vue-calendarium/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zehenrique/vue-calendarium.git"
  },
  "bugs": {
    "url": "https://github.com/zehenrique/vue-calendarium/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vuetify": "^4.0.0"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@mdi/font": "^7.4.47",
    "hammerjs": "^2.0.8",
    "ical.js": "^2.2.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "marked": "^18.0.14",
    "playwright": "^1.64.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.14",
    "vuetify": "^4.2.4"
  }
}
